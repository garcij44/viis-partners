---
/**
 * Pages import their own stylesheet: the homepage is on the redesign system
 * (src/styles/system.css) while 404 and /thanks stay on the pre-redesign
 * global.css until they are migrated. The two define the same custom
 * property names with different values and cannot load together.
 */
interface Props {
  title: string;
  description: string;
  /** Path to the social share image, resolved against the site origin. */
  image?: string;
  /** OpenGraph type; "website" for the homepage, "article" etc. elsewhere. */
  ogType?: string;
  /** Keep the page out of the index. For utility pages (404, /thanks) that
      have no search value but should still pass link equity onward. */
  noindex?: boolean;
  /** Additional JSON-LD graphs for this page (the homepage adds FAQPage). */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = '/og-image.png',
  ogType = 'website',
  noindex = false,
  schema = [],
} = Astro.props;

// Absolute URLs are required for canonical + OG tags. Astro.site is the
// configured origin; without it these would silently emit relative URLs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const siteName = 'VIIS Partners';

// ProfessionalService (a LocalBusiness subtype) structured data, brief §4.
// Only facts the business supports: names, locality, service area, contact
// email, the service lines. No street address, phone, hours, prices, or
// ratings — none exist to state. The legal entity is VIIS, LLC doing
// business as VIIS Partners until the Texas assumed-name filing completes.
const origin = new URL('/', Astro.site).href;
const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${origin}#business`,
  name: siteName,
  legalName: 'VIIS, LLC',
  alternateName: 'VIIS', // the logotype and sign-off short form
  // WHY a fixed string: the node shares one @id across every page, so it
  // must say the same thing on every page; the page description is the
  // page's, not the business's.
  description:
    'Technology consulting in San Antonio: websites you own, and the DNS, email, Google Workspace, search, and automation underneath them.',
  url: origin,
  email: 'jgarcia@viispartners.com',
  image: imageUrl,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'San Antonio',
    addressRegion: 'TX',
    addressCountry: 'US',
  },
  areaServed: [
    { '@type': 'City', name: 'San Antonio' },
    { '@type': 'State', name: 'Texas' },
  ],
  founder: { '@type': 'Person', name: 'Jadrin Garcia' },
  knowsAbout: [
    'Website design and development',
    'DNS and email authentication',
    'Google Workspace and Microsoft 365 administration',
    'Local search and technical SEO',
    'Lead capture and business automation',
  ],
};
const graphs = [business, ...schema];

// Analytics (brief §4): GA4 and Search Console. Both are gated on build-time
// variables so a build with neither set ships no third-party script and no
// verification tag. See .env.example and README.
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string | undefined;
const siteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION as string | undefined;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<meta name="theme-color" content="#121319" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{siteVerification && <meta name="google-site-verification" content={siteVerification} />}

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<!-- OpenGraph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="VIIS Partners — your website, and the systems that hold it up" />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />

		<!-- Fonts. Mono is preloaded too: it is the signature face and renders
		     above the fold (logotype + location line). -->
		<link rel="preload" href="/fonts/fraunces-variable.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/geist-sans-variable.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/geist-mono-variable.woff2" as="font" type="font/woff2" crossorigin />

		{graphs.map((graph) => <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />)}
		{gaId && <script is:inline src="/scripts/analytics.js" data-measurement-id={gaId} defer />}
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<slot />
	</body>
</html>
