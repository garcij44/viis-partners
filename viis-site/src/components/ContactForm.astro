---
/**
 * ContactForm — the site's primary conversion point.
 *
 * Works with zero JavaScript: it is a plain <form method="post"> that posts to
 * PUBLIC_FORM_ENDPOINT. The enhancement script only *enhances* it (inline
 * states, client validation) — it is never the only line of defence.
 *
 * Field set is fixed at six by ART-DIRECTION.md → "Field discipline":
 * Name, Email, Service required; Phone, Company, Project optional. Adding a
 * seventh requires amending that file first.
 *
 * SECURITY NOTE: client validation here is for usability only. The endpoint
 * that receives this MUST independently validate, normalise, length-limit, and
 * output-encode every field server-side, and enforce rate limiting + the
 * honeypot/timestamp checks. See README → "Form architecture" + "Security".
 */
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '/api/contact';
const accessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY ?? '';

// WHY: this repo has already shipped a form that posted into a 404 for weeks.
// A missing access key produces a form that looks perfect and drops every lead
// silently, so it fails the build instead of reaching production.
if (endpoint.includes('web3forms.com') && !accessKey) {
  throw new Error(
    'PUBLIC_FORM_ACCESS_KEY is required when PUBLIC_FORM_ENDPOINT points at Web3Forms. ' +
      'Set it in the workflow env: block — see README → Deployment.',
  );
}

const services = [
  { value: 'Secure', label: 'Secure' },
  { value: 'Adopt', label: 'Adopt' },
  { value: 'Build', label: 'Build' },
  { value: 'Advise', label: 'Advise' },
  { value: 'Not sure yet', label: 'Not sure yet' },
];
---

<form
  class="inquiry"
  method="post"
  action={endpoint}
  aria-labelledby="inquiry-heading"
>
  {/* Web3Forms routing fields. The access key is public by design — it
      identifies the form, it does not authorise anything. Anyone can POST to
      it, which is what botcheck and the server-side filter are for. */}
  {accessKey && <input type="hidden" name="access_key" value={accessKey} />}
  <input type="hidden" name="subject" value="New inquiry — viispartners.com" />
  <input type="hidden" name="from_name" value="VIIS site" />

  {/* Honeypot. A checkbox, not a text input: password managers autofill text
      fields that look like company/URL fields, and a filled honeypot used to
      make a real lead disappear. A checkbox is never autofilled. */}
  <div class="hp" aria-hidden="true">
    <label for="botcheck">Leave this unchecked</label>
    <input id="botcheck" name="botcheck" type="checkbox" tabindex="-1" />
  </div>

  {/* Anti-bot timing signal. Stamped with load time by the enhancement script;
      EMPTY when JavaScript is off. A backend consuming this MUST treat an empty
      value as "no signal" and accept, never reject. See README → Form contract. */}
  <input type="hidden" name="form_render_ts" value="" data-render-ts />

  <div class="field">
    <label class="field-label" for="name">Name</label>
    <input
      class="field-input"
      id="name"
      name="name"
      type="text"
      required
      maxlength="100"
      autocomplete="name"
      aria-required="true"
      aria-describedby="name-error"
    />
    <p class="field-error" id="name-error" data-error hidden></p>
  </div>

  <div class="field">
    <label class="field-label" for="email">Work email</label>
    <input
      class="field-input"
      id="email"
      name="email"
      type="email"
      required
      maxlength="200"
      autocomplete="email"
      inputmode="email"
      aria-required="true"
      aria-describedby="email-error"
    />
    <p class="field-error" id="email-error" data-error hidden></p>
  </div>

  {/* Radio group, not a <select>: the open state of a native select is
      OS-rendered and cannot be styled, which breaks the "reads as a document"
      rule at the moment of interaction. The mono row also rhymes with the
      section labels above, so the choice names the sections it refers to. */}
  <fieldset
    class="field field-group"
    role="radiogroup"
    aria-labelledby="service-legend"
    aria-required="true"
    aria-describedby="service-error"
  >
    <legend class="field-label" id="service-legend">Service of interest</legend>
    <div class="option-row">
      {
        services.map((service, i) => (
          <>
            <input
              class="option-input"
              type="radio"
              id={`service-${i}`}
              name="service"
              value={service.value}
              required
            />
            <label class="option-label" for={`service-${i}`}>
              {service.label}
            </label>
          </>
        ))
      }
    </div>
    <p class="field-error" id="service-error" data-error hidden></p>
  </fieldset>

  <div class="field">
    <label class="field-label" for="phone">
      Phone <span class="field-optional">optional</span>
    </label>
    {/* WHY: no format mask and no client-side pattern. International numbering
        varies enough that validation rejects real numbers more often than it
        catches typos, and this field is optional anyway. */}
    <input
      class="field-input"
      id="phone"
      name="phone"
      type="tel"
      maxlength="40"
      autocomplete="tel"
      aria-describedby="phone-error"
    />
    <p class="field-error" id="phone-error" data-error hidden></p>
  </div>

  <div class="field">
    <label class="field-label" for="company">
      Company <span class="field-optional">optional</span>
    </label>
    <input
      class="field-input"
      id="company"
      name="company"
      type="text"
      maxlength="120"
      autocomplete="organization"
      aria-describedby="company-error"
    />
    <p class="field-error" id="company-error" data-error hidden></p>
  </div>

  <div class="field">
    <label class="field-label" for="project">
      Project or challenge <span class="field-optional">optional</span>
    </label>
    <textarea
      class="field-input field-textarea"
      id="project"
      name="project"
      rows="4"
      maxlength="1500"
      aria-describedby="project-hint project-error"></textarea>
    <p class="field-hint type-small" id="project-hint">
      What you're trying to do, and where you're stuck. A few sentences is plenty.
    </p>
    <p class="field-error" id="project-error" data-error hidden></p>
  </div>

  <div class="inquiry-actions">
    <button class="cta cta-submit" type="submit" data-submit>
      <span data-submit-label>Request a consultation</span>
      <svg class="cta-arrow" width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
        <path d="M1 7.5h11M8 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" />
      </svg>
    </button>
  </div>

  {/* Single live region for submit state. Announced politely; never a toast.
      tabindex="-1" so success can move focus here — see inquiry.js. */}
  <p class="inquiry-status" role="status" aria-live="polite" tabindex="-1" data-status></p>

  <p class="inquiry-note type-small">
    We use what you send only to reply to your inquiry. No newsletter, no
    tracking. Your message reaches us by email through a form processor and is
    not stored elsewhere. Jadrin reads every message and replies personally.
  </p>
</form>

<!-- Enhancement served as a static, same-origin module so the strict CSP
     (script-src 'self') allows it with no hash or nonce. -->
<script is:inline type="module" src="/scripts/inquiry.js"></script>
