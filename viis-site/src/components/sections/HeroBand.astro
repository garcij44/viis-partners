---
/**
 * HeroBand — the one treatment shared by section 1 (hero) and section 10
 * (closing CTA), brief §2. Both references repeat the identical CTA rather
 * than varying it, so the copy, trust line, and both buttons are fixed here
 * and rendered twice. The closing restates the headline as an h2 (one h1
 * per page) at the same display size, and carries no artifact.
 *
 * The green field is a ::before, not a background, so the hero's field can
 * run up behind the transparent site header the way Canopy's nav sits on
 * its field. The closing field enters from and leaves to flat ink, so it
 * needs no knowledge of the sections around it.
 *
 * The field is interpolated in OKLab and carries a monochrome grain layer
 * (an inline feTurbulence, no data URI, so the self-only CSP holds). The
 * grain is the only thing that breaks the 8-bit banding a slow fade
 * between two near-blacks produces; the colour space does not, since both
 * paths land on the same pixels at these values. Chosen from the four-way
 * board on /dev/design-system, 2026-09-06. The grain fades out over the
 * band's last section-pad (and the closing's first), so the edge where the
 * grain stops no longer reads as a faint line against the plain ink.
 *
 * The service pages reuse the hero with their own eyebrow, headline, and
 * subhead; the trust line and both buttons stay fixed. Defaults are the
 * homepage's copy, so the homepage renders as before.
 */
import Section from '../Section.astro';
import Eyebrow from '../Eyebrow.astro';
import Button from '../Button.astro';

interface Props {
  variant: 'hero' | 'closing';
  /** Section id; the heading id is derived from it for aria-labelledby. */
  id: string;
  eyebrow?: string;
  heading?: string;
  sub?: string;
  /** Where "See the work" goes; service pages point back at the proof. */
  workHref?: string;
}

const {
  variant,
  id,
  eyebrow = 'Technology consulting · San Antonio',
  heading = 'Your website, and the systems that hold it up.',
  sub = "A site that loads slowly. Email landing in spam. A Google Workspace nobody ever configured. DNS records missing since the last vendor. VIIS builds the website and fixes what's underneath it — then stays on to keep it working.",
  workHref = '#proof',
} = Astro.props;
const headingId = `${id}-heading`;
const Heading = variant === 'hero' ? 'h1' : 'h2';
const hasArtifact = Astro.slots.has('artifact');
// WHY the filter id is the variant, not the section id: the stylesheet
// references it by name (see .band--hero::after). Nothing may be passed
// through an inline style attribute: staticwebapp.config.json ships
// style-src 'self', which blocks style attributes, and an unset custom
// property here once left the grain layer at opacity 1 and crushed the
// field to black in production while every local preview looked right.
const grainId = `grain-${variant}`;
---

<Section id={id} class={`band band--${variant}`} labelledby={headingId}>
  {/* Definition only. Nothing here paints: the filter lives in <defs> and
      the SVG is 0×0 and out of flow, so it can never take layout. The
      band's ::after references it by id and does the painting. */}
  <svg class="grain-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <filter id={grainId} x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
        <feComponentTransfer>
          <feFuncA type="table" tableValues="1 1" />
        </feComponentTransfer>
      </filter>
    </defs>
  </svg>
  <div class="copy">
    <Eyebrow class="kicker">{eyebrow}</Eyebrow>
    <Heading id={headingId} class="t-display-1 headline">{heading}</Heading>
    <p class="t-lead fg-2 sub">{sub}</p>
    <Eyebrow as="p" dot muted class="trust">
      Free audit · No obligation · Results in 3 business days
    </Eyebrow>
    <div class="actions">
      <Button href="#audit">Get your free site audit</Button>
      <Button href={workHref} variant="secondary">See the work</Button>
    </div>
  </div>
  {
    hasArtifact && (
      <div class="artifact">
        <slot name="artifact" />
      </div>
    )
  }
</Section>

<style>
  /* The field. isolation creates the stacking context that lets the
     ::before sit behind this section's content without falling behind
     the body background. */
  .band {
    position: relative;
    isolation: isolate;
  }

  .band::before,
  .band::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  /* The grain: the band's ::after, painted through the filter the 0×0 SVG
     defines, over the field and under the copy. Overlay is zero-mean, so
     the field's colour holds. WHY the ink background: the filter graph
     never reads its source, but Safari skips a filter on a box that paints
     nothing, so the box paints ink and the turbulence replaces it.
     WHY 0.3: overlay scales with the base, and this base is ~0.08. At 0.3
     the grain moves a pixel by about ±1 level of 255, one band's worth;
     at 0.06 it measured nothing. Both values live here, never inline. */
  .band::after {
    background: var(--ink);
    opacity: 0.3;
    mix-blend-mode: overlay;
  }

  .band--hero::after {
    filter: url(#grain-hero);
  }

  .band--closing::after {
    filter: url(#grain-closing);
  }

  .grain-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* Hero: solid field behind the chrome and the copy, fading to flat ink by
     the section end so the artifact's lower edge sits on the page ground.
     WHY the negative top: the site header is transparent and --header-h
     tall (components.css), and the field has to run up behind it. */
  .band--hero::before,
  .band--hero::after {
    top: calc(-1 * var(--header-h));
  }

  /* The grain fades to nothing over the band's last section-pad, so where
     it stops is not a visible edge. The closing band fades at both ends. */
  .band--hero::after {
    -webkit-mask-image: linear-gradient(#000 calc(100% - var(--section-pad)), transparent);
    mask-image: linear-gradient(#000 calc(100% - var(--section-pad)), transparent);
  }

  .band--closing::after {
    -webkit-mask-image: linear-gradient(
      transparent,
      #000 var(--section-pad),
      #000 calc(100% - var(--section-pad)),
      transparent
    );
    mask-image: linear-gradient(
      transparent,
      #000 var(--section-pad),
      #000 calc(100% - var(--section-pad)),
      transparent
    );
  }

  .band--hero::before {
    background: linear-gradient(
      180deg in oklab,
      var(--accent-field-a) 0%,
      var(--accent-field-a) 40%,
      var(--accent-field-b) 100%
    );
  }

  /* Closing: enters from the flat ink above, holds the field behind the
     headline and buttons, and settles back to ink before the footer. */
  .band--closing::before {
    background: linear-gradient(
      180deg in oklab,
      var(--accent-field-b) 0%,
      var(--accent-field-a) 30%,
      var(--accent-field-a) 60%,
      var(--accent-field-b) 100%
    );
  }

  /* One text column, measured at body size (brief §1: never past 68ch).
     WHY on the block, not the lead: 68ch resolved against the 21px lead is
     947px, about 85 characters a line. Against body size it is 812px,
     about 72, which is where a lead paragraph still reads as one breath.
     Measured at 1440: the balanced headline runs 541 and 576px, so the
     column is set by the subhead, not the display face. */
  .copy {
    max-width: var(--measure);
  }

  /* The eyebrow primitive is inline-flex; flex here so each label takes
     its own line box at its own line-height instead of sitting in an 18px
     body strut. */
  .kicker,
  .trust {
    display: flex;
  }

  .headline {
    margin-top: var(--sp-5);
  }

  .sub {
    margin-top: var(--sp-5);
  }

  .trust {
    margin-top: var(--sp-6);
    /* The dot has no baseline of its own, so flex uses its bottom edge:
       it sits on the first line's baseline when the label wraps at ≤414px
       and lands within a pixel of centred when it does not. */
    align-items: baseline;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-6);
  }

  .artifact {
    margin-top: var(--sp-9);
  }

  @media (max-width: 767px) {
    /* Stacked, full-width buttons: the primary label alone is wider than
       the 327px column at 375, and a thumb wants the whole row anyway. */
    .actions {
      flex-direction: column;
      align-items: stretch;
    }

    .artifact {
      margin-top: var(--sp-8);
    }
  }
</style>
