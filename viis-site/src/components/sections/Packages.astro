---
/**
 * Section 7, packages (brief §2.7): the rate card's four recurring tiers,
 * each with its price and what it includes. Builds are projects, not plans,
 * so they are not here and carry no price; the Websites line in the method
 * covers design, build, migration, and launch, and builds are quoted after
 * the audit.
 *
 * Plan prices shown (decided by Jadrin 2026-09-23 from a rendered mockup,
 * reversing the earlier "no numbers" rule). A plan is a set monthly price
 * per tier on the Notion rate card (§2), the same for every client. A
 * build is chosen from the audit's findings and quoted after it, so no
 * build price appears. Partner shows no number: its monthly project
 * capacity is defined per client.
 *
 * Read against docs/canopy-05-pricing-toolkit.png: one panel divided into
 * columns by hairlines, a name with its price, a short list, and a line
 * beneath the panel. The price uses the audit section's treatment (mono,
 * fg-2, the receipt's dotted leader, name and price inside one h3 so a
 * screen reader hears them together). Canopy's check icons are left out
 * (brief §1: no icons outside the four-up row); the list mark is the
 * site's jade dot, as in the reframe's findings.
 *
 * Inclusions and the "who it's for" lines are the rate card's, as Jadrin
 * supplied them on 2026-09-06, and nothing is added to them. The line under
 * the panel is the rate card's takeover onboarding, which leads into Watch
 * or Care only; larger setups take the Systems Audit instead.
 *
 * "Talk it through" goes to the audit form: the brief's secondary
 * conversion is a call, and no booking mechanism exists yet.
 *
 * Layout: one row of four from lg, two by two from sm, one column below.
 * Four tiers divide evenly at every step, so no card is ever orphaned.
 *
 * The eyebrow, headline, and subhead are not in the brief; provisional
 * copy until confirmed.
 */
import Section from '../Section.astro';
import Eyebrow from '../Eyebrow.astro';
import Card from '../Card.astro';
import Button from '../Button.astro';

interface Tier {
  id: string;
  name: string;
  price: string;
  audience: string;
  included: string[];
}

const tiers: Tier[] = [
  {
    id: 'tier-watch',
    name: 'Watch',
    price: 'From $149/mo',
    audience: 'A simple site with nothing automated behind it.',
    included: [
      'Hosting',
      'DNS and SSL monitoring',
      'Backups',
      'Updates',
      'Break/fix response',
      'Quarterly report',
    ],
  },
  {
    id: 'tier-care',
    name: 'Care',
    price: 'From $299/mo',
    audience: 'A standard build, with Workspace or automations in the picture.',
    included: [
      'Everything in Watch',
      'Monthly report',
      'A set allowance of changes each month',
      'Google Workspace and Microsoft 365 management',
      'DNS and email-authentication monitoring',
      'Automation health checks',
      'Quarterly call',
    ],
  },
  {
    id: 'tier-growth',
    name: 'Growth',
    price: 'From $650/mo',
    audience: 'A larger site, live automations, and content going out.',
    included: [
      'Everything in Care',
      'A larger monthly allowance',
      'Priority response',
      'Quarterly audit and roadmap',
      'Monthly call',
    ],
  },
  {
    id: 'tier-partner',
    name: 'Partner',
    price: 'Scoped with you',
    audience: 'You want a technical lead, not a vendor.',
    included: [
      'Everything in Growth',
      'Defined project capacity each month',
      'Systems architecture',
      'Vendor management',
      'Automation maintenance',
    ],
  },
];
---

<Section id="packages" labelledby="packages-heading">
  <Eyebrow class="kicker">Packages</Eyebrow>
  <h2 id="packages-heading" class="headline">Four plans for after launch.</h2>
  <p class="t-lead fg-2 measure sub">
    Builds are projects, quoted after the audit. These are the plans that keep the site and the
    systems under it working once it is live.
  </p>

  <Card class="panel">
    <ul class="tiers">
      {
        tiers.map(({ id, name, price, audience, included }) => (
          <li class="tier">
            <h3 id={id} class="name">
              <span class="name-text">{name}</span>
              <span class="leader" aria-hidden="true"></span>
              <span class="price t-mono fg-2">{price}</span>
            </h3>
            <p class="t-small fg-2 audience">{audience}</p>
            <ul class="included t-small">
              {included.map((item) => <li>{item}</li>)}
            </ul>
            {/* Three links share a label; the tier name describes each. */}
            <Button variant="secondary" href="#audit" class="cta" aria-describedby={id}>
              Talk it through
            </Button>
          </li>
        ))
      }
    </ul>
  </Card>
  <p class="takeover t-small fg-3">
    Already have a site you like? We can take it over as is: a one-time $500 onboarding, then
    Watch or Care.
  </p>
</Section>

<style>
  .kicker {
    display: flex;
  }

  .headline {
    margin-top: var(--sp-5);
  }

  .sub {
    margin-top: var(--sp-5);
  }

  /* The panel carries no padding of its own: each tier pads itself so the
     dividers run edge to edge. overflow clips the dividers to the corner. */
  .panel {
    margin-top: var(--sp-8);
    padding: 0;
    overflow: hidden;
  }

  .tiers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  /* --sp-5 padding, not the card's --sp-6: four columns in the container
     are 280px each, and 32px a side would leave the longest inclusion
     three lines deep. */
  .tier {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--sp-5);
    border-left: 1px solid var(--hairline);
    container-type: inline-size;
  }

  /* WHY transparent, not 0: every column keeps the same 1px, so all four
     have the same content width and cross the container query below at
     the same viewport. With border-left: 0 the first column was 1px wider
     and stayed on one line at 1200 while the other three stacked. */
  .tier:first-child {
    border-left-color: transparent;
  }

  /* Name, leader, price on one baseline: the audit section's tier heading
     (Audit.astro), so both prices on the page read the same way.
     WHY --sp-2 and not the audit's --sp-3: at 1440 a column holds 231px, and
     "Partner" with "Scoped with you" needs 226px at --sp-2. At --sp-3 it
     overflowed by 3px. */
  .name {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    align-self: stretch;
    text-wrap: initial;
  }

  .name-text,
  .price {
    flex: none;
  }

  .leader {
    flex: 1;
    min-width: var(--sp-4);
    height: 1px;
    border-bottom: 1px dotted var(--fg-3);
  }

  .takeover {
    margin-top: var(--sp-5);
  }

  /* WHY a container query, not a media query: the column narrows at three
     different viewport ranges (four-up just past 1024, two-up near 640, one
     column at 320). Every tier is the same width, so all four stack
     together, never one alone. 227px is the widest single line, Partner's,
     measured. Stacked, there is no gap for a leader to bridge. */
  @container (max-width: 227px) {
    .name {
      flex-direction: column;
      gap: var(--sp-1);
    }

    .leader {
      display: none;
    }
  }

  .audience {
    margin-top: var(--sp-3);
  }

  .included {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    margin-top: var(--sp-5);
    margin-bottom: var(--sp-6);
  }

  .included > li {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
  }

  /* The jade mark: the same 6px dot as the eyebrow and the findings list. */
  .included > li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* The button sits at the foot of every column, level across the row. */
  .cta {
    margin-top: auto;
  }

  /* Two by two under lg (the four-up row's own step), one column under
     sm. Dividers: left edges on every column but the first of its row,
     top edges on every row but the first. */
  @media (max-width: 1023px) {
    .tiers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tier:nth-child(2n + 1) {
      border-left-color: transparent;
    }

    .tier:nth-child(n + 3) {
      border-top: 1px solid var(--hairline);
    }
  }

  @media (max-width: 639px) {
    .tiers {
      grid-template-columns: minmax(0, 1fr);
    }

    .tier {
      border-left-color: transparent;
    }

    .tier:nth-child(n + 2) {
      border-top: 1px solid var(--hairline);
    }
  }

  /* Under 768 the buttons fill the column, as the hero's and the form's do. */
  @media (max-width: 767px) {
    .tier {
      padding: var(--sp-5);
    }

    .cta {
      align-self: stretch;
    }
  }
</style>
