---
/**
 * Eyebrow — the mono label above a headline. `dot` adds the small jade
 * mark used on the hero trust line. `muted` swaps accent-dim for cream-dim
 * where a section already has its one accent.
 */
interface Props {
  as?: 'p' | 'span' | 'div' | 'h2' | 'h3';
  dot?: boolean;
  muted?: boolean;
  class?: string;
}

// Rest spread forwards the parent's scoped-style attribute; see Section.astro.
const { as: Tag = 'p', dot = false, muted = false, class: className = '', ...rest } = Astro.props;
const classes = ['eyebrow', 't-label', muted && 'eyebrow--muted', className]
  .filter(Boolean)
  .join(' ');
---

<Tag class={classes} {...rest}>
  {dot && <span class="eyebrow__dot" aria-hidden="true"></span>}
  <slot />
</Tag>
