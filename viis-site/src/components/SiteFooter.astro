---
/**
 * SiteFooter — carried-over chrome. The brief specifies no footer, so this
 * holds only the sign-off, on the new tokens, until one is designed.
 *
 * The sign-off renders the legal entity as VIIS, LLC (d/b/a VIIS Partners)
 * until the Texas assumed-name filing completes, the privacy link, and the
 * contact email (brief §4). No byline: the founder is named in the
 * ProfessionalService graph (Layout.astro) and on the privacy page, and
 * the audit section carries the site's one first-person line.
 */
---

<footer class="site-footer">
  <div class="container inner">
    <p class="t-mono fg-2">VIIS, LLC (d/b/a VIIS Partners)</p>
    <p class="t-mono fg-2 links">
      <a class="link" href="/privacy/">Privacy</a>
      <a class="link" href="mailto:jgarcia@viispartners.com">jgarcia@viispartners.com</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline);
    padding-block: var(--sp-6);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-5);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
  }
</style>
