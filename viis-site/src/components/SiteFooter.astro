---
/**
 * SiteFooter — carried-over chrome. The brief specifies no footer, so this
 * holds only what the old page already said, on the new tokens, until one
 * is designed.
 */
---

<footer class="site-footer">
  <div class="container inner">
    <p class="t-mono fg-2">VIIS · Jadrin Garcia, Principal · San Antonio, Texas</p>
    <p class="t-mono fg-2">viispartners.com</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline);
    padding-block: var(--sp-6);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-5);
  }
</style>
