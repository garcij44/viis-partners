---
/**
 * Homepage — redesign brief §2, built in the brief's order (§6).
 * All ten sections are in place: 1 (hero), 2 (capability row), 3 (reframe),
 * 4 (method), 5 (proof), 6 (comparison), 7 (packages), 8 (the audit),
 * 9 (FAQ), and 10 (closing CTA). The head carries the ProfessionalService
 * graph from the layout plus FAQPage from the FAQ data.
 *
 * Chrome is SiteHeader (logotype, nav to the four service pages, audit
 * CTA) and SiteFooter (carried over; the brief specifies no footer).
 */
import '../styles/system.css';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroBand from '../components/sections/HeroBand.astro';
import CapabilityRow from '../components/sections/CapabilityRow.astro';
import Reframe from '../components/sections/Reframe.astro';
import Method from '../components/sections/Method.astro';
import Proof from '../components/sections/Proof.astro';
import Comparison from '../components/sections/Comparison.astro';
import Packages from '../components/sections/Packages.astro';
import Audit from '../components/sections/Audit.astro';
import Faq from '../components/sections/Faq.astro';
import { faqSchema } from '../data/faq';
import { AUDIT_POINT_COUNT } from '../data/audit';
import SiteFooter from '../components/SiteFooter.astro';
---

{/* Title and description are the homepage's own (brief §4: unique per page).
    The title leads with what the business does and where, and ends on the
    brand; the description names the four service lines and the free audit.
    Both are provisional copy until Jadrin confirms them. */}
<Layout
	title="Websites and the systems under them | VIIS Partners, San Antonio"
	description={`Websites you own, and the DNS, email, Google Workspace, search, and automation underneath them. Technology consulting in San Antonio. Free ${AUDIT_POINT_COUNT}-point audit.`}
	schema={[faqSchema()]}
>
	<SiteHeader />

	<main id="main">
		<HeroBand variant="hero" id="hero">
			{/* The real artifact is an audit report rendered as the hero
			    image (brief §2.1, §6 blocking dependency). It does not exist yet.
			    This frame holds its slot at the artifact's dimensions — container
			    width, 16:10, --radius-lg — and says so, rather than inventing one. */}
			<div slot="artifact" class="artifact-placeholder">
				<p class="t-mono fg-2">Placeholder · audit report · not yet produced</p>
			</div>
		</HeroBand>

		<CapabilityRow />
		<Reframe />
		<Method />
		<Proof />
		<Comparison />
		<Packages />
		<Audit />
		<Faq />

		<HeroBand variant="closing" id="closing" />
	</main>

	<SiteFooter />
</Layout>

<style>
	.artifact-placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--sp-2);
		aspect-ratio: 16 / 10;
		padding: var(--sp-5);
		text-align: center;
		color: var(--fg-3);
		background: var(--surface);
		border: 1px dashed var(--hairline-hover);
		border-radius: var(--radius-lg);
	}
</style>
