---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';

// The four parallel services. ENGAGE is deliberately NOT in this array: it is
// process, not an offering, and gets a structurally different treatment below.
const services = [
	{
		label: 'SECURE',
		title: "Secure what you've built",
		text: "Most small businesses run on systems no one has reviewed in years: access left open, backups never tested, accounts never closed. We find the gaps and close them, then give you a security posture you can stand behind — identity and access done right, monitoring that means something, and a plan for the day something goes wrong.",
	},
	{
		label: 'ADOPT',
		title: 'Adopt AI without the exposure',
		text: "AI is the fastest way for a small business to move quicker — and the fastest way to leak everything it knows. We help you put it to work safely: what's safe to feed it, where your data goes, which tools earn their place, and how to stay in control as you grow. Set up, governed, and managed, so you get the upside without becoming the cautionary tale.",
	},
	{
		label: 'BUILD',
		title: "Build what you can't buy",
		text: 'When off-the-shelf won\'t do, we design and build it — applications, internal tools, and sites, engineered properly and owned entirely by you. This is premium custom work: it costs what real software costs, and at the end it is yours, source and all. No lock-in, no per-seat tax, no rented platform holding your business hostage.',
	},
	{
		label: 'ADVISE',
		title: 'Stay in the room',
		text: 'Technology decisions don\'t stop at launch. We stay on as your senior technical bench — the people you call before you sign the vendor contract, wire the money, or click the link. On-call judgment, without the cost of a full-time hire.',
	},
];

// Full-lifecycle capability. Structured from the owner's provided taxonomy;
// wording is intentionally terse and factual, pending final owner sign-off.
// Middle phase is "Deliver" (not "Build") to avoid colliding with the BUILD
// service label above.
const lifecycle = [
	{
		label: 'DEFINE',
		lede: 'Before anything is built.',
		items: 'Technical discovery and requirements. Risk assessment. Architecture and technology selection.',
	},
	{
		label: 'DELIVER',
		lede: 'Built securely from the start.',
		items: 'Secure implementation. Cloud and platform configuration. Identity and access. Data handling. Integration and testing.',
	},
	{
		label: 'LAUNCH',
		lede: 'Into production, and beyond.',
		items: 'Production-readiness and security review. Deployment and monitoring. Operational handoff and post-launch support.',
	},
];

const engageText =
	'We take on a few clients at a time and commit fully for the length of the need: senior attention instead of a junior team learning on your budget, a fixed monthly engagement instead of a meter running on every question, outcomes instead of tickets. When the work is done, it is genuinely done — documented, handed over, and yours to run.';
---

<Layout
	title="VIIS — A technology practice for owner-led businesses"
	description="VIIS secures the systems you depend on, helps you adopt AI without exposing your business, and builds the software you can't buy off the shelf. One senior team, a few clients at a time."
>
	<header class="site-header">
		<div class="bar header-inner">
			<a class="logotype" href="/">VIIS</a>
			<span class="header-meta">San Antonio, Texas</span>
		</div>
	</header>

	<main id="main">
		<section class="hero grid">
			<div class="col-1-9">
				<h1 class="type-h1 hero-lead">
					VIIS is a technology practice<br class="hero-break" /> for businesses that have
					outgrown guesswork.
				</h1>
				<p class="type-body hero-support measure">
					<span class="hero-support-lead">One senior team. A few clients at a time.</span>
					<span class="hero-support-sub">Embedded fully, for as long as the work demands.</span>
				</p>
				<hr class="hero-rule" />
			</div>
		</section>

		{
			services.map((service) => (
				<section class="section grid">
					<div class="col-1-3 section-label">
						<span class="type-label">{service.label}</span>
					</div>
					<div class="col-4-11">
						<h2 class="type-h3 section-heading">{service.title}</h2>
						<p class="type-body measure">{service.text}</p>
					</div>
				</section>
			))
		}

		<section class="lifecycle grid">
			<div class="col-1-9 lifecycle-head">
				<span class="type-label lifecycle-label">APPROACH</span>
				<h2 class="type-h2">From first decision to production.</h2>
				<p class="type-body measure lifecycle-sub">
					One disciplined arc for every engagement, whether we're hardening what you already run or
					building something new: decisions made responsibly, execution done securely, and the work
					carried all the way to launch and handoff.
				</p>
			</div>
			<div class="col-1-12 phases">
				{
					lifecycle.map((phase) => (
						<div class="phase">
							<span class="type-label phase-label">{phase.label}</span>
							<p class="type-h3 phase-lede">{phase.lede}</p>
							<p class="type-body phase-items">{phase.items}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="engage">
			<div class="grid">
				<div class="col-1-9">
					<span class="type-label engage-label">ENGAGE</span>
					<h2 class="type-h2 engage-heading">How we work</h2>
					<p class="type-body measure">{engageText}</p>
				</div>
			</div>
		</section>

		<section class="closing grid">
			<div class="col-1-9">
				<p class="type-h2">
					For owner-led businesses that take their systems seriously — and would rather pay once
					for something done right than repeatedly for something done cheap.
				</p>
			</div>
		</section>

		<section class="contact grid" id="contact">
			<div class="col-1-3 section-label">
				<span class="type-label">CONTACT</span>
			</div>
			<div class="col-4-11">
				<h2 class="type-h2 contact-lede" id="inquiry-heading">Start a conversation.</h2>
				<p class="type-body measure contact-intro">
					Tell us what you're working on. If it's a fit, we'll set up a call to talk it through;
					if it isn't, we'll say so and point you somewhere better.
				</p>

				<ContactForm />

				<p class="type-small contact-alt">
					Prefer email?{' '}
					<a class="cta cta-inline" href="mailto:jgarcia@viispartners.com">
						jgarcia@viispartners.com
						<svg class="cta-arrow" width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
							<path d="M1 7.5h11M8 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" />
						</svg>
					</a>
				</p>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div class="bar footer-inner">
			<p class="footer-line">VIIS · Jadrin Garcia, Principal · San Antonio, Texas</p>
			<p class="footer-line">viispartners.com</p>
		</div>
	</footer>
</Layout>
