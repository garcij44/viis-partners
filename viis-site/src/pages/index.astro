---
/**
 * Homepage — redesign brief §2, built in the brief's order (§6).
 * Sections in place: 1 (hero), 2 (capability row), 3 (reframe), 4 (method),
 * and 10 (closing CTA). Sections 5–9 follow.
 *
 * The header is SiteHeader (logotype, audit CTA, no nav links). The
 * footer is carried-over chrome: the brief specifies none, so it holds only
 * what the old page already said, on the new tokens, until one is designed.
 */
import '../styles/system.css';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroBand from '../components/sections/HeroBand.astro';
import CapabilityRow from '../components/sections/CapabilityRow.astro';
import Reframe from '../components/sections/Reframe.astro';
import Method from '../components/sections/Method.astro';
---

<Layout
	title="VIIS Partners — Your website, and the systems that hold it up."
	description="A site that loads slowly. Email landing in spam. A Google Workspace nobody ever configured. VIIS builds the website and fixes what's underneath it."
>
	<SiteHeader />

	<main id="main">
		<HeroBand variant="hero" id="hero">
			{/* The real artifact is an audit report rendered as the hero
			    image (brief §2.1, §6 blocking dependency). It does not exist yet.
			    This frame holds its slot at the artifact's dimensions — container
			    width, 16:10, --radius-lg — and says so, rather than inventing one. */}
			<div slot="artifact" class="artifact-placeholder">
				<p class="t-mono fg-2">Placeholder · audit report · not yet produced</p>
			</div>
		</HeroBand>

		<CapabilityRow />
		<Reframe />
		<Method />

		<HeroBand variant="closing" id="closing" />
	</main>

	<footer class="site-footer">
		<div class="container footer-inner">
			<p class="t-mono fg-2">VIIS · Jadrin Garcia, Principal · San Antonio, Texas</p>
			<p class="t-mono fg-2">viispartners.com</p>
		</div>
	</footer>
</Layout>

<style>
	.site-footer {
		border-top: 1px solid var(--hairline);
		padding-block: var(--sp-6);
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--sp-2) var(--sp-5);
	}

	.artifact-placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--sp-2);
		aspect-ratio: 16 / 10;
		padding: var(--sp-5);
		text-align: center;
		color: var(--fg-3);
		background: var(--surface);
		border: 1px dashed var(--hairline-hover);
		border-radius: var(--radius-lg);
	}
</style>
