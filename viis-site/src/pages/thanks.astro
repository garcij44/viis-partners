---
/**
 * Confirmation page for the no-JavaScript submit path.
 *
 * With JS on, the audit form confirms inline and never navigates here. With
 * JS off the browser performs a real POST to /api/audit and the function
 * answers with a 303 to this page.
 */
import '../styles/system.css';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
---

<Layout
	title="Request received — VIIS Partners"
	description="Your free site audit request has been received. The report follows within three business days."
	noindex
>
	<SiteHeader />

	<main id="main">
		<Section labelledby="thanks-heading">
			<Eyebrow class="kicker">Received</Eyebrow>
			<h1 id="thanks-heading" class="headline">Your audit request is in.</h1>
			<p class="t-lead fg-2 measure sub">
				A confirmation is on its way to your inbox. The report follows within three business
				days. If anything is urgent before then, reply to that email.
			</p>
			<div class="actions">
				<Button href="/" variant="secondary">Back to the site</Button>
			</div>
		</Section>
	</main>

	<SiteFooter />
</Layout>

<style>
	.kicker {
		display: flex;
	}

	.headline {
		margin-top: var(--sp-5);
	}

	.sub {
		margin-top: var(--sp-5);
	}

	.actions {
		margin-top: var(--sp-6);
	}
</style>
