---
/**
 * Confirmation page for the no-JavaScript submit path.
 *
 * With JS on, the form confirms inline and never navigates here. With JS off
 * the browser performs a real cross-origin POST, and the form backend's own
 * response is raw JSON — so the form passes a `redirect` field pointing here
 * and the visitor lands on something that belongs to the site.
 *
 * Reuses the utility-page shell (see 404.astro); no page-specific CSS.
 */
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Inquiry received — VIIS Partners"
	description="Your inquiry has been received. Jadrin will read it and reply directly."
	noindex
>
	<header class="site-header">
		<div class="bar header-inner">
			<a class="logotype" href="/">VIIS</a>
			<span class="header-meta">San Antonio, Texas</span>
		</div>
	</header>

	<main id="main">
		<section class="hero grid">
			<div class="col-1-9">
				<span class="type-label notice-label">RECEIVED</span>
				<h1 class="type-h1 notice-heading">Your inquiry is in.</h1>
				<p class="type-body measure notice-sub">
					Jadrin reads every message and will reply to you directly.
				</p>
				<a class="cta notice-cta" href="/">
					Back to the start
					<svg class="cta-arrow" viewBox="0 0 15 15" fill="none" aria-hidden="true">
						<path d="M1 7.5h11M8 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" />
					</svg>
				</a>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div class="bar footer-inner">
			<p class="footer-line">VIIS · Jadrin Garcia, Principal · San Antonio, Texas</p>
			<p class="footer-line">viispartners.com</p>
		</div>
	</footer>
</Layout>
