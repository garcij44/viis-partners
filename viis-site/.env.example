# Build-time variables. PUBLIC_ values are inlined into the built HTML by
# Astro; set them in the GitHub Actions build step's env (or repository
# variables), never in a committed .env.
#
# GA4 measurement ID for the property that owns viispartners.com. Unset,
# the site ships no analytics script at all.
PUBLIC_GA_MEASUREMENT_ID=
#
# Search Console HTML-tag verification token (the content of the
# google-site-verification meta tag). Not needed if the property is
# verified through DNS or through the GA4 property instead.
PUBLIC_GOOGLE_SITE_VERIFICATION=
#
# The audit form's backend (viis-site/api) reads its settings at request time
# from the Static Web App's application settings. For local development copy
# api/local.settings.example.json to api/local.settings.json. See README →
# "Form architecture" and "Configure the form for production".
