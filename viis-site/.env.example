# -----------------------------------------------------------------------------
# VIIS site — environment variables
# Copy to `.env` for local dev. `.env` is git-ignored; never commit real values.
# -----------------------------------------------------------------------------

# Endpoint the contact form submits to (POST).
#
# The PUBLIC_ prefix means Astro inlines this into the client bundle — it is
# visible in the browser BY DESIGN. Only ever put a non-secret URL here. Never
# an API key, token, or private webhook secret.
#
# Fallback when unset: "/api/contact" (a same-origin route, see README →
# "Form architecture"). The Content-Security-Policy in
# public/staticwebapp.config.json currently allows form submissions to 'self'
# ONLY. If you point this at a third-party form backend (a different origin),
# you MUST add that origin to BOTH `form-action` and `connect-src` in the CSP,
# or the browser will block the submission.
PUBLIC_FORM_ENDPOINT="https://api.web3forms.com/submit"

# Web3Forms form identifier. PUBLIC by design: it is rendered into the HTML and
# anyone can read it. It identifies the form; it authorises nothing. That does
# mean anyone can POST to it, which is what the botcheck honeypot and the
# server-side filtering are for.
#
# In CI this comes from the GitHub secret of the same name, set in the
# workflow's `env:` block — NOT in the Azure Portal. Astro bakes import.meta.env
# at build time and the build runs in GitHub Actions, so Portal settings never
# reach the bundle. See README → Deployment.
#
# The build FAILS if the endpoint is Web3Forms and this is unset, rather than
# shipping a form that looks correct and drops every lead.
PUBLIC_FORM_ACCESS_KEY=""
